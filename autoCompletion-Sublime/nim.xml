<?xml version="1.0" encoding="UTF-8"?>
<NotepadPlus>
    <AutoComplete language="nim">
        <Environment ignoreCase="no" startFunc="(" stopFunc=")" paramSeparator="," additionalWordChar="" />
        <KeyWord name="for" />
        <KeyWord name="proc" />
        <KeyWord name="tabtospace" func="yes">
            <Overload retVal="" descr="For tab loving people">
                <Param name='sub = "\t"' />
                <Param name='by = "  "' />
            </Overload>
        </KeyWord>
    </AutoComplete>
</NotepadPlus>
