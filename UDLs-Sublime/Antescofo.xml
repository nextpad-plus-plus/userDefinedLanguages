            <Keywords name="Keywords3">during fun_def macro_def map obj_def pattern_def proc_def ta w where within</Keywords>
            <Keywords name="Keywords4"></Keywords>
            <Keywords name="Keywords5">chord event multi pm state trill</Keywords>
            <Keywords name="Keywords6">abs action atan car cdr ceil clear concat cons cos cosh count dim exp find_index flatten floor global grain insert iota is_bool is_fct is_float is_int is_interpolatedmap is_map is_numeric is_string is_symbol is_ta is_undef lace local log log10 log2 map max max_val member min min_val normalize occurs permute pow push_back push_front rank reduce refractory remove remove_duplicate replace reshape resize reverse rotate scan scramble sin sinh size sort sputter sqrt stutter tan target type</Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="FFFFFF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
