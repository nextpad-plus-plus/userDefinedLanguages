            <Keywords name="Keywords1"></Keywords>
            <Keywords name="Keywords2"></Keywords>
            <Keywords name="Keywords3"></Keywords>
            <Keywords name="Keywords4"></Keywords>
            <Keywords name="Keywords5">and_e and_i and_n arith assoc cases comm contr contrapos distr dm eq_e equiv exists_e exists_i exists_n forall_e forall_i forall_n idemp iff_br iff_e iff_i iff_mp imp_br imp_e imp_i impl lem neg not_and_br not_e not_exists_n not_forall_n not_iff_br not_imp_n not_not_e not_not_i not_not_n not_or_n or_br or_e or_i raa set simp1 simp2 trans</Keywords>
            <Keywords name="Keywords6"></Keywords>
            <Keywords name="Keywords7"></Keywords>
            <Keywords name="Keywords8"></Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="FFFFFF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="COMMENTS" fgColor="00FF00" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="LINE COMMENTS" fgColor="00FF00" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="FF8040" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="0080FF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="FFFF00" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="00FF80" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="FF80FF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS5" fgColor="80C0FF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS6" fgColor="FFC000" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS7" fgColor="C0C0C0" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
