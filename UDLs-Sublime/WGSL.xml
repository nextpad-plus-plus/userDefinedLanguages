            <WordsStyle name="OPERATORS" fgColor="FFFFFF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="FFFFFF" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
            <WordsStyle name="DELIMITERS1" fgColor="FF8000" bgColor="2E2E2E" colorStyle="1" fontStyle="0" nesting="0" />
